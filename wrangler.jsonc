{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dragonsagaonline",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dragonsagaonline"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bun add --no-save @opennextjs/cloudflare@1.20.6 && bunx opennextjs-cloudflare build"
  }
}
